{
  "name": "bike-spare-parts-inventory",
  "version": "1.0.0",
  "description": "Bike Repair Shop Spare Parts Inventory Web App (MERN Stack)",
  "main": "server/server.js",
  "scripts": {
    "build": "npm --prefix server install && npm --prefix client install && npm --prefix client run build",
